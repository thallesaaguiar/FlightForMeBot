# Required: flight data
SERPAPI_KEY=                 # serpapi.com, live Google Flights prices (free plan: 250 searches/month)
TRAVELPAYOUTS_TOKEN=         # travelpayouts.com, free cached Aviasales prices
# TRAVELPAYOUTS_MARKER=      # optional affiliate id appended to Aviasales links

# Required: Telegram
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # comma-separated admin chat ids; the bot tells you yours on first message
OPEN_SIGNUP=0                # 1 = anyone can use the alert commands (free-text chat stays admin-only)

# Optional: free-text chat with an LLM
CHAT_LLM=1                   # 0 = commands only, no LLM spend
LLM=claude,ollama            # order to try; providers without a key/model are skipped
LLM_MAX_SEARCHES=10          # paid searches allowed per /agente question
BUSCAR_LIVE=3                # dates confirmed live per guided search
CHAT_MODE=buscar             # plain messages start: buscar (guided) or agente
SESSION_MINUTES=60           # idle minutes before a chat forgets the current search
EXTRACT_EFFORT=low           # Ollama reasoning effort for reading requests: low, medium, high
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
OLLAMA_MODEL=                # e.g. gpt-oss:20b; setting it enables the local provider
# OLLAMA_URL=http://localhost:11434/v1

# Money
CURRENCY=BRL
SERPAPI_MONTHLY_CAP=250      # hard stop for paid searches per month (0 blocks every search)

# Optional: miles and points search (Seats.aero Pro, US$ 9.99/month, personal use only). Unset = off.
SEATS_AERO_KEY=
